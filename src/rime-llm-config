    print(f"  {C_GRY}日志: {DEBUG_LOG}{C_RES}\n")

    try:
        os.makedirs(os.path.dirname(DEBUG_FLAG), exist_ok=True)
        os.makedirs(os.path.dirname(DEBUG_LOG), exist_ok=True)
        # 1. 放置触发器，激活 Lua 日志（路径通过 config.lua 告知 Lua，重新导出一次保证一致）
