    text = str(text or "")
    if not text.strip():
        return ""
    for needle, vid in LEGACY_THINKING_MAP:
        if needle in text:
            return vid
    return ""


def profile_thinking(profile, model=None):
    model = model if model is not None else str(profile.get("model", ""))
    thinking = profile.get("thinking")
    if isinstance(thinking, dict):
        return str(thinking.get(model, "") or "")
    return ""


def set_profile_thinking(profile, model, vid):
    thinking = profile.get("thinking")
    if not isinstance(thinking, dict):
        thinking = {}
        profile["thinking"] = thinking
    if vid:
        thinking[model] = vid
    else:
        thinking.pop(model, None)


