def cli_handler():
    if len(sys.argv) > 1:
        cmd = sys.argv[1].lower()
        if cmd in ("-h", "--help", "help"): print_help(); return True
        elif cmd == "init": init_rime_config(); return True
        elif cmd == "debug":
            run_debug()
            return True
        elif cmd == "ask":
            sys.exit(run_ask(sys.argv[2:]))
        elif cmd == "chat":
            sys.exit(run_chat(sys.argv[2:]))
        elif cmd == "usage":
            sys.exit(run_usage(sys.argv[2:]))
        elif cmd in ("reset-prompt", "reset_prompt"):
            sys.exit(run_reset_prompt())
        elif cmd == "sync":
            state = load_state()
            if _MIGRATED_PREFIXES:
                # 前缀刚从提示词里拆出来，落一次盘，用户在 state.json 里看到的就是新结构
                if os.path.exists(STATE_FILE):
                    backup_file(STATE_FILE)
                save_state(state)
                print(f"{L_OK} " + t("cli_migrated"))
                out = LUA_FILE
            else:
                out = export_to_lua(state)
            print(f"{L_OK} " + t("cli_sync_ok", out))
            return True
        elif cmd == "catalog":
            try:
                cat = catalog_refresh()
                print(f"{L_OK} " + t("cli_catalog_ok", len(cat), CATALOG_FILE))
            except Exception as e:
                print(f"{L_ERR} " + t("cli_catalog_fail", e))
            return True
        elif cmd == "status":
            state = load_state()
            active = state.get("active_profile", "None")
            p = state["profiles"].get(active, {})
            s = state.get("settings", {})
            resolved = resolve_request(p, s, active) if p else {"protocol": "-", "thinking": "", "request_extra": {}, "model": ""}
            print(f"{t('cli_stat_prof')} {active} ({p.get('name', 'N/A')})")
            print(f"{t('cli_stat_model')} {p.get('model', 'None')}" + (f" → {resolved['model']}" if resolved.get('model') and resolved['model'] != p.get('model') else ""))
            print(f"{t('cli_stat_proto')} {resolved['protocol']}" + (f" ({profile_binary(p)})" if p and profile_is_cli(p) else ""))
            print(f"{t('cli_stat_think')} {variant_label(resolved['thinking'] or 'off')}")
            if resolved.get("request_extra"):
                print(f"{t('cli_stat_extra')} {json.dumps(resolved['request_extra'], ensure_ascii=False)}")
            print(f"{t('cli_stat_state')} {STATE_FILE}")
            print(f"{t('cli_stat_lua')} {LUA_FILE}")

            print(f"\n{C_CYN}{C_BLD}[ {t('tui_opt_settings')} ]{C_RES}")
            print(f"  {pad_str(t('tui_st_trigger'), 25)}: {s.get('ai_trigger', 'vv')}")
            print(f"  {pad_str(t('tui_st_tokens'), 25)}: {s.get('max_tokens', 4000)}")
            print(f"  {pad_str(t('tui_st_temp'), 25)}: {s.get('temperature', 0.1)}")
            print(f"  {pad_str(t('tui_st_time'), 25)}: {s.get('max_time', 30.0)}")
            print(f"  {pad_str(t('tui_st_history_bytes'), 25)}: {s.get('max_history_bytes', 240)}")
            prefix = str(s.get("miyu_prefix", DEFAULT_MIYU_PREFIX) or "").strip()
            if prefix:
                try:
                    where = find_miyu(s)
                except Exception as e:
                    where = f"! {e}"
                miyu_desc = (f"{prefix} → session '{s.get('miyu_session', DEFAULT_MIYU_SESSION)}', "
                             f"wait {s.get('miyu_wait', DEFAULT_MIYU_WAIT)}s / max {s.get('miyu_timeout', DEFAULT_MIYU_TIMEOUT)}s, "
                             f"tools={'on' if s.get('miyu_tools') else 'off'}, {where}")
            else:
                miyu_desc = "off"
            print(f"  {pad_str(t('cli_stat_miyu'), 25)}: {miyu_desc}")
            inj = t('tui_inject_auto') if str(s.get('prefix_inject', 'auto')) == 'auto' else t('tui_inject_all')
            vinj = t('tui_inject_auto') if str(s.get('vocab_inject', 'auto')) == 'auto' else t('tui_inject_all')
            disk = 'on' if s.get('reply_cache_disk', True) else 'off'
            core_len = len(prompt_layers(state)[0])
            print(f"  {pad_str(t('cli_stat_saver'), 25)}: prompt={inj} / vocab={vinj} / cache={disk}"
                  f" / core={core_len}{'字' if LANG == 'zh' else ' chars'}")

            prompt = s.get("prompt", "None")
            print(f"\n{C_CYN}{C_BLD}[ {t('tui_st_prompt')} ]{C_RES}")
            print(f"{C_GRY}{prompt}{C_RES}\n")
            return True
        elif cmd == "tui": return False
        else:
            print(f"{L_ERR} " + t("cli_err_cmd", cmd))
            print_help()
            return True
    return False

