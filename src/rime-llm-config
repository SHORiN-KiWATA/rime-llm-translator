            os.remove(DEBUG_FLAG)
        print(f"{L_OK} 调试监控已关闭，输入法恢复静默模式。")

def load_usage():
    try:
        with open(USAGE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def run_usage(argv):
    """token 用量：数字由 Lua 侧每次 HTTP 请求后从响应的 usage 字段累加进 usage.json。"""
    if argv and argv[0] in ("--reset", "reset", "-r"):
        try:
            os.remove(USAGE_FILE)
        except OSError:
            pass
        print(f"{L_OK} " + t("cli_usage_reset"))
        return 0
    u = load_usage()
    reqs = int(u.get("requests") or 0)
    if not reqs:
        print(f"{L_WARN} " + t("cli_usage_none"))
        return 0
    pin = int(u.get("prompt") or 0)
    cached = int(u.get("cached") or 0)
    out = int(u.get("completion") or 0)
    billed = (pin - cached) + cached * 0.1
    hit = f" ({cached:,} cached / {cached * 100 // max(pin, 1)}%)" if cached else ""
    since = datetime.datetime.fromtimestamp(u.get("since") or 0).strftime("%Y-%m-%d %H:%M")
    print(f"\n{C_CYN}{C_BLD}{t('cli_usage_title')}{C_RES}")
    print(f"  {pad_str(t('cli_usage_since'), 26)}: {since}")
    print(f"  {pad_str(t('cli_usage_req'), 26)}: {reqs:,}")
    print(f"  {pad_str(t('cli_usage_in'), 26)}: {pin:,}{hit}")
    print(f"  {pad_str(t('cli_usage_out'), 26)}: {out:,}")
    print(f"  {pad_str(t('cli_usage_avg'), 26)}: {pin // reqs:,}")
    print(f"  {pad_str(t('cli_usage_billed'), 26)}: {billed / reqs:,.0f} / {C_GRN}{billed:,.0f}{C_RES}")
    recent = u.get("recent")
    if isinstance(recent, list) and recent:
        print(f"\n{C_CYN}{C_BLD}[ {t('cli_usage_recent')} ]{C_RES}")
        for e in recent[-10:]:
            if not isinstance(e, dict):
                continue
            ts = datetime.datetime.fromtimestamp(e.get("t") or 0).strftime("%H:%M:%S")
            c = int(e.get("cached") or 0)
            print(f"  {C_GRY}{ts}{C_RES}  in {int(e.get('in') or 0):>6,}"
                  + (f" {C_GRN}(cache {c:,}){C_RES}" if c else " " * 14)
                  + f"  out {int(e.get('out') or 0):>5,}  {C_GRY}{e.get('m', '')}{C_RES}")
    print()
    return 0


def run_reset_prompt():
    """把提示词换回程序自带的默认版本（自带版本是按分层裁剪重写过的精简版）。"""
    state = load_state()
