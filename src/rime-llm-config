def migrate_profile(profile):
    """旧字段 → 新字段：thinking_mode（显示文案）/ effort → thinking{model: id}，protocol 规范化。"""
    if not isinstance(profile, dict):
        return profile
    proto = stored_protocol(profile)
    profile["protocol"] = proto
    thinking = profile.get("thinking")
    if not isinstance(thinking, dict):
        thinking = {}
    model = str(profile.get("model", "") or "")
    legacy = legacy_thinking_id(profile.pop("thinking_mode", ""))
    if legacy and model and model not in thinking:
        thinking[model] = legacy
    effort = str(profile.pop("effort", "") or "").strip().lower()
    if effort and model and model not in thinking:
        thinking[model] = effort
    profile["thinking"] = {str(k): str(v) for k, v in thinking.items() if v}
    return profile


_MIGRATED_PREFIXES = False


def default_prefixes():
    return {
        "rules": [{"key": k, "rule": r} for k, r in DEFAULT_PREFIXES],
        "combo": DEFAULT_PREFIX_COMBO,
        "fallback": DEFAULT_PREFIX_FALLBACK,
    }


def migrate_prefixes(data):
    """老结构（规则写在提示词 markdown 里）→ 结构化的 prefixes。返回有没有真的迁移。

    切不出规则就什么都不动，继续走 split_prompt 那条老路——不能因为解析不了就把用户的
    前缀行为丢掉。
    """
    global _MIGRATED_PREFIXES
    pf = data.get("prefixes")
    if isinstance(pf, dict) and isinstance(pf.get("rules"), list):
        pf.setdefault("combo", DEFAULT_PREFIX_COMBO)
        pf.setdefault("fallback", DEFAULT_PREFIX_FALLBACK)
        return False
    settings = data.setdefault("settings", {})
    core, rules, combo, _head = split_prompt(settings.get("prompt", ""))
    if not rules:
        return False
    # 摘掉行首的 `- `jp:`前缀，` 这层壳，key 已经单独存了；正文保留用户自己的措辞
    strip = re.compile(r"^\s*[-*]\s*`[a-z]+:`\s*(?:前缀[，,：:]\s*)?")
    rewritten = dict(DEFAULT_PREFIXES)
    out = []
    for key, raw in rules.items():
        body = strip.sub("", raw).strip()
        # 跟老版一字不差 = 用户没改过，换成重写后的版本（约束输出而非描述过程）
        if body == LEGACY_PREFIX_RULES.get(key) and key in rewritten:
            body = rewritten[key]
        out.append({"key": key, "rule": body})
    combo_body = re.sub(r"^#+\s.*\n?", "", combo).strip()
    if combo_body.startswith(LEGACY_COMBO_HEAD):
        combo_body = DEFAULT_PREFIX_COMBO
    data["prefixes"] = {"rules": out, "combo": combo_body, "fallback": DEFAULT_PREFIX_FALLBACK}
    settings["prompt"] = core
    _MIGRATED_PREFIXES = True
    return True


def migrate_state(data, default_state):
    # 必须赶在下面那个"补齐 default_state 里的顶层键"之前：default_state 自带 prefixes，
    # 先补进来的话 migrate_prefixes 会以为已经是新结构，老用户提示词里的规则段就摘不掉了
    migrate_prefixes(data)
    for k in default_state:
        if k not in data:
            data[k] = default_state[k]
    if not isinstance(data.get("profiles"), dict):
        data["profiles"] = {}
    if not isinstance(data.get("settings"), dict):
        data["settings"] = {}
    for k, v in default_state.get("settings", {}).items():
        data["settings"].setdefault(k, v)
    data["settings"].setdefault("cli_timeout", DEFAULT_CLI_TIMEOUT)
    for k, v in TOKEN_SAVER_DEFAULTS.items():
        data["settings"].setdefault(k, v)
    for k, v in (("miyu_prefix", DEFAULT_MIYU_PREFIX), ("miyu_session", DEFAULT_MIYU_SESSION),
                 ("miyu_timeout", DEFAULT_MIYU_TIMEOUT), ("miyu_wait", DEFAULT_MIYU_WAIT),
                 ("miyu_tools", False), ("miyu_prompt", DEFAULT_MIYU_PROMPT), ("miyu_binary", "")):
        data["settings"].setdefault(k, v)
    # 自带节点只播种一次：记下已经播过的 id，用户删掉的不再复活
    seeded = data.get("seeded_defaults")
    default_ids = list(default_state.get("profiles", {}).keys())
    if not isinstance(seeded, list):
        seeded = sorted(set(default_ids) | set(data["profiles"].keys()))
    else:
        for pk, pv in default_state["profiles"].items():
            if pk not in seeded and pk not in data["profiles"]:
                data["profiles"][pk] = pv
                seeded.append(pk)
    data["seeded_defaults"] = seeded
    for pid in list(data["profiles"]):
        data["profiles"][pid] = migrate_profile(data["profiles"][pid])
    return data


def load_state():
    default_state = get_default_state()
    if not os.path.exists(STATE_FILE):
        return sync_external_profiles(migrate_state(json.loads(json.dumps(default_state)), default_state))
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, dict):
            raise ValueError("state.json is not an object")
        return sync_external_profiles(migrate_state(data, default_state))
    except Exception:
        return sync_external_profiles(migrate_state(json.loads(json.dumps(default_state)), default_state))


def save_state(state, export=True):
    """写 state.json；默认顺手导出 config.lua，保证两条线（HTTP 读 config.lua、CLI 读 state.json）一致。"""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        json.dump(state, f, ensure_ascii=False, indent=4)
    if export:
        try:
            export_to_lua(state)
        except Exception:
            pass


def lua_str(s):
    """Lua 双引号字符串字面量。"""
    s = str(s if s is not None else "")
    out = []
    for ch in s:
        if ch == "\\": out.append("\\\\")
        elif ch == '"': out.append('\\"')
        elif ch == "\n": out.append("\\n")
        elif ch == "\r": out.append("\\r")
        elif ch == "\t": out.append("\\t")
        elif ord(ch) < 32 or ord(ch) == 127: out.append("\\%03d" % ord(ch))
        else: out.append(ch)
    return '"' + "".join(out) + '"'


def lua_long(s):
    """Lua 长字符串，自动挑一个内容里不存在的等号级别。"""
    s = str(s if s is not None else "")
    level = 1
    while f"]{'=' * level}]" in s:
        level += 1
    eq = "=" * level
    return f"[{eq}[{s}]{eq}]"


def lua_num(v, default):
    try:
        f = float(v)
    except (TypeError, ValueError):
        f = float(default)
    if f == int(f) and "." not in str(v):
        return str(int(f))
    return repr(f)


def lua_list(items):
    return "{ " + ", ".join(lua_str(x) for x in items) + " }"


def lua_bool(v):
    return "true" if v else "false"


def ensure_private_dir(path):
    if not path:
        return False
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
        os.chmod(path, 0o700)
        return True
    except OSError:
        return False


def export_to_lua(state):
    settings = state.get("settings", {})
    tmp_dirs = [d for d in (RUNTIME_TMP_DIR, CONFIG_TMP_DIR) if ensure_private_dir(d)]

    # 提示词切成「常驻核心 + 按需片段」，Lua 侧照着拼；切不动就核心=全文、规则表为空，
    # Lua 那边照旧整份发送。
    prompt_core, prompt_rules, prompt_combo, prompt_fallback, prompt_head = prompt_layers(state)
    words = rule_words(prompt_rules)
    rules_str = "".join(
        f"\n        [{lua_str(k)}] = {lua_long(prompt_rules[k])}," for k in words if k in prompt_rules
    )
    vocab_terms = [str(x) for x in state.get("vocab", {}).get("terms", []) if str(x).strip()]
    stamp = hashlib.sha1(
        (str(settings.get("prompt", "")) + "\0" + json.dumps(state.get("vocab", {}), sort_keys=True, ensure_ascii=False)
         ).encode("utf-8")).hexdigest()[:12]
    vocab_maps = ", ".join(
        f"{{ {lua_str(k)}, {lua_str(v)} }}"
        for k, v in (state.get("vocab", {}).get("mappings") or {}).items() if str(k).strip()
    )
    os.makedirs(CACHE_DIR, exist_ok=True)

    profiles_str = ""
    for pid, p in state.get("profiles", {}).items():
        if not isinstance(p, dict):
            continue
        resolved = resolve_request(p, settings, pid)
        lines = [
            f"name = {lua_str(p.get('name', pid))}",
            f"protocol = {lua_str(resolved['protocol'])}",
            f"api_url = {lua_str(p.get('api_url', ''))}",
            f"api_key = {lua_str(p.get('api_key', ''))}",
            f"model = {lua_str(resolved['model'])}",
            f"thinking = {lua_str(resolved['thinking'])}",
            f"binary = {lua_str(profile_binary(p) if profile_is_cli(p) else '')}",
        ]
        if resolved["request_extra"]:
            lines.append(f"request_extra = {lua_long(json.dumps(resolved['request_extra'], ensure_ascii=False))}")
        if resolved["temperature"] is False:
            lines.append("temperature = false")
        elif resolved["temperature"] is not None:
            lines.append(f"temperature = {lua_num(resolved['temperature'], 0.1)}")
        body = "\n".join("            " + l + "," for l in lines)
        profiles_str += f"\n        [{lua_str(pid)}] = {{\n{body}\n        }},"

    lua_code = f"""-- =========================================================
-- 文件名：config.lua
-- 存放位置：{CONFIG_DIR}
-- 由 rime-llm-config 自动生成，请勿手动修改此文件！
-- 思考档 / 厂商私有字段已经解析成每个节点的 request_extra，Lua 只负责拼接。
-- =========================================================

return {{
    active_profile = {lua_str(state.get('active_profile', ''))},
    profiles = {{{profiles_str}
    }},
    ai_trigger = {lua_str(settings.get('ai_trigger', 'vv'))},
    prompt = {lua_long(settings.get('prompt', ''))},
    prompt_core = {lua_long(prompt_core)},
    prompt_rules = {{{rules_str}
    }},
    prompt_rules_head = {lua_str(prompt_head)},
    prompt_combo = {lua_long(prompt_combo)},
    rule_words = {lua_list(words)},
    prefix_inject = {lua_str(settings.get('prefix_inject', 'auto'))},
    vocab_prompt = {lua_long(vocab_block(state.get('vocab', {})))},
    vocab = {{
        title = {lua_str(VOCAB_TITLE)},
        terms_head = {lua_str(VOCAB_TERMS_HEAD)},
        maps_head = {lua_str(VOCAB_MAPS_HEAD)},
        terms = {lua_list(vocab_terms)},
        maps = {{ {vocab_maps} }},
    }},
    vocab_inject = {lua_str(settings.get('vocab_inject', 'auto'))},
    no_history_prefixes = {lua_list(sorted(no_history_prefix_set(settings)))},
    adaptive_max_tokens = {lua_bool(settings.get('adaptive_max_tokens', True))},
    prompt_cache_mark = {lua_bool(settings.get('prompt_cache_mark', True))},
    reply_cache_disk = {lua_bool(settings.get('reply_cache_disk', True))},
    reply_cache_file = {lua_str(REPLY_CACHE_FILE)},
    prompt_stamp = {lua_str(stamp)},
    reply_cache_max = {lua_num(settings.get('reply_cache_max', DEFAULT_REPLY_CACHE_MAX), DEFAULT_REPLY_CACHE_MAX)},
    reply_cache_min_len = {lua_num(settings.get('reply_cache_min_len', DEFAULT_REPLY_CACHE_MIN_LEN), DEFAULT_REPLY_CACHE_MIN_LEN)},
    usage_file = {lua_str(USAGE_FILE)},
    max_tokens = {lua_num(settings.get('max_tokens', 4000), 4000)},
    temperature = {lua_num(settings.get('temperature', 0.1), 0.1)},
    connect_timeout = {lua_num(settings.get('connect_timeout', 2.0), 2.0)},
    max_time = {lua_num(settings.get('max_time', 30.0), 30.0)},
    max_history_bytes = {lua_num(settings.get('max_history_bytes', DEFAULT_HISTORY_BYTES), DEFAULT_HISTORY_BYTES)},
    cli_timeout = {lua_num(settings.get('cli_timeout', DEFAULT_CLI_TIMEOUT), DEFAULT_CLI_TIMEOUT)},
    miyu_prefix = {lua_str(str(settings.get('miyu_prefix', DEFAULT_MIYU_PREFIX) or '').strip())},
    prompt_fallback = {lua_long(prompt_fallback)},
    prefix_position = {lua_str(prefix_position(settings))},
    prefix_words = {lua_list(words)},
    config_tool = {lua_str(os.path.realpath(sys.argv[0]))},
    tmp_dirs = {{ {", ".join(lua_str(d) for d in tmp_dirs)} }},
    debug_flag = {lua_str(DEBUG_FLAG)},
    debug_log = {lua_str(DEBUG_LOG)},
}}
"""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".config-", suffix=".lua", dir=CONFIG_DIR)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(lua_code)
    os.replace(tmp, LUA_FILE)
    return LUA_FILE

