def stored_protocol(profile):
    """profile 的协议存盘值（规范化），未知值当 auto。"""
    return PROTOCOL_ALIASES.get(str(profile.get("protocol", "")).strip().lower(), "auto")


def url_looks_anthropic(url):
    u = (url or "").lower().rstrip("/")
    return "anthropic" in u or u.endswith("/messages")


def effective_protocol(profile):
    """把 auto 解析成具体协议：Anthropic 看 URL，其余一律 OpenAI Chat。"""
    proto = stored_protocol(profile)
    if proto != "auto":
        return proto
    return "anthropic" if url_looks_anthropic(profile.get("api_url", "")) else "openai-chat"


def profile_protocol(profile):
    return effective_protocol(profile)


def is_cli_protocol(protocol):
    return protocol in CLI_BACKENDS


def profile_is_cli(profile):
    return is_cli_protocol(stored_protocol(profile))


def profile_binary(profile):
    protocol = stored_protocol(profile)
    return str(profile.get("binary", "")).strip() or CLI_BACKENDS.get(protocol, {}).get("binary", "")


def profile_tag(profile):
    if profile.get("source") == "miyu":
        return t("tui_sm_tag_miyu")
    if profile_is_cli(profile):
        return t("tui_sm_tag_cli")
    return ""


def profile_is_usable(profile):
    """能否被设为激活节点：CLI 节点只要有模型，HTTP 节点要 URL + Key + 模型。"""
    if not profile.get("model"):
        return False
    if profile_is_cli(profile):
        return True
    return bool(profile.get("api_url") and profile.get("api_key"))


def protocol_label(proto):
    return {"auto": t("proto_auto"), "openai-chat": t("proto_openai"), "anthropic": t("proto_anthropic")}.get(proto, proto)


def protocol_from_label(label):
    for proto in HTTP_PROTOCOLS:
        if protocol_label(proto) == label:
            return proto
    return "auto"


