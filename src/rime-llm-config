def strip_jsonc(text):
    """去掉 // 与 /* */ 注释（跳过字符串内部），Miyu 的 config.jsonc 用。"""
    out = []
    i, n = 0, len(text)
    in_str = False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 2
                continue
            if c == '"':
                in_str = False
            i += 1
            continue
        if c == '"':
            in_str = True
            out.append(c)
            i += 1
        elif text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
        elif text.startswith("/*", i):
            end = text.find("*/", i + 2)
            i = n if end < 0 else end + 2
        else:
            out.append(c)
            i += 1
    return "".join(out)


def split_api_keys(raw):
    """Miyu 的 api_key 可以是逗号/换行分隔的多把 key，也可以是 $env:NAME。"""
    keys = []
    for line in str(raw or "").splitlines():
        for item in line.split(","):
            item = item.strip()
            if not item:
                continue
            if item.startswith("$env:"):
                item = os.environ.get(item[5:].strip(), "").strip()
            if item:
                keys.append(item)
    return keys


def cli_model_catalog(protocol, binary=""):
    """本机 CLI 的模型清单：能问命令的就问（缓存一天），否则用预置列表。"""
    backend = CLI_BACKENDS.get(protocol)
    if not backend:
        return []
    binary = binary or backend["binary"]
    cache_file = os.path.join(MODELS_CACHE_DIR, f"{protocol}.json")
    try:
        if time.time() - os.path.getmtime(cache_file) < 86400:
            with open(cache_file, "r", encoding="utf-8") as f:
                cached = json.load(f)
            if isinstance(cached, list) and cached:
                return cached
    except (OSError, ValueError):
        pass
    models = []
    try:
        if protocol == "codex":
            out = subprocess.run([binary, "debug", "models"], capture_output=True, text=True, timeout=20).stdout
            models = [m.get("slug", "") for m in json.loads(out).get("models", [])
                      if isinstance(m, dict) and m.get("visibility") != "hide" and m.get("slug")]
        elif protocol == "antigravity":
            out = subprocess.run([binary, "models"], capture_output=True, text=True, timeout=20).stdout
            models = [line.split("\t", 1)[0].strip() for line in out.splitlines()
                      if line.strip() and not line.startswith("Fetching")]
        elif protocol == "opencode":
            out = subprocess.run([binary, "models"], capture_output=True, text=True, timeout=20).stdout
            models = [line.split()[0] for line in out.splitlines() if line.strip()]
    except Exception:
        models = []
    if models:
        try:
            os.makedirs(MODELS_CACHE_DIR, exist_ok=True)
            with open(cache_file, "w", encoding="utf-8") as f:
                json.dump(models, f)
        except OSError:
            pass
        return models
    return list(backend["models"])


def builtin_cli_profiles():
    """PATH 上找得到的 CLI 各生成一个 profile。"""
    profiles = {}
    for protocol, backend in CLI_BACKENDS.items():
        if not shutil.which(backend["binary"]):
            continue
        profiles[backend["id"]] = {
            "name": backend["name"], "protocol": protocol, "api_url": "", "api_key": "",
            "binary": backend["binary"], "model": backend["default"], "thinking": {}, "source": "builtin",
        }
    return profiles


def miyu_thinking_defaults():
    try:
        with open(MIYU_THINKING, "r", encoding="utf-8") as f:
            data = json.load(f)
        selected = data.get("selected") if isinstance(data, dict) else None
        return selected if isinstance(selected, dict) else {}
    except (OSError, ValueError):
        return {}


def miyu_profiles():
    """只读导入 Miyu 的供应商：id 前缀 miyu_；CLI 中转线映射到同名协议，HTTP 线要有 key。"""
    try:
        with open(MIYU_CONFIG, "r", encoding="utf-8") as f:
            cfg = json.loads(strip_jsonc(f.read()))
    except (OSError, ValueError):
        return {}
    if not isinstance(cfg, dict):
        return {}
    plugins = cfg.get("plugins") if isinstance(cfg.get("plugins"), dict) else {}
    thinking_defaults = miyu_thinking_defaults()
    profiles = {}
    for prov in cfg.get("providers") or []:
        if not isinstance(prov, dict) or prov.get("enabled", True) is False:
            continue
        raw_id = str(prov.get("id", "")).strip()
        if not raw_id:
            continue
        raw_protocol = str(prov.get("protocol", "")).strip().lower()
        if raw_protocol == "openai-responses":
            continue
        base_url = str(prov.get("base_url", "")).strip().rstrip("/")
        protocol = PROTOCOL_ALIASES.get(raw_protocol)
        if protocol is None:
            continue
        keys = split_api_keys(prov.get("api_key") or "")
        api_key = keys[0] if keys else ""
        models = [str(m).strip() for m in (prov.get("models") or []) if str(m).strip()]
        default_model = str(prov.get("default_model") or (models[0] if models else "")).strip()
        binary = ""
        if is_cli_protocol(protocol):
            plugin_key = {"claude-code": "claude_code", "antigravity": "antigravity", "codex": "codex"}.get(protocol)
            if plugin_key and isinstance(plugins.get(plugin_key), dict):
                binary = str(plugins[plugin_key].get("binary", "")).strip()
            if not shutil.which(binary or CLI_BACKENDS[protocol]["binary"]):
                continue
            api_url = ""
            default_model = default_model or CLI_BACKENDS[protocol]["default"]
        else:
            if not api_key or not base_url:
                continue
            is_anthropic = protocol == "anthropic" or "anthropic" in base_url.lower()
            if is_anthropic:
                protocol = "anthropic"
                api_url = base_url + ("/messages" if base_url.lower().endswith("/v1") else "/v1/messages")
            elif "generativelanguage" in base_url.lower():
                api_url = base_url + ("/openai/chat/completions" if not base_url.lower().endswith("/openai") else "/chat/completions")
            else:
                api_url = base_url if base_url.lower().endswith("/chat/completions") else base_url + "/chat/completions"
        pid = "miyu_" + re.sub(r"[^a-zA-Z0-9_]", "_", raw_id)
        thinking = {}
        for m in set(models + [default_model]):
            vid = str(thinking_defaults.get(f"{raw_id}\t{m}", "") or "")
            if vid:
                thinking[m] = "off" if vid == "none" else vid
        profile = {
            "name": str(prov.get('display_name') or raw_id), "protocol": protocol,
            "api_url": api_url, "api_key": api_key, "binary": binary,
            "model": default_model, "thinking": thinking, "source": "miyu",
        }
        if isinstance(prov.get("model_temperature"), dict):
            profile["model_temperature"] = {str(k): v for k, v in prov["model_temperature"].items()}
        if isinstance(prov.get("extra_body"), dict):
            profile["extra_body"] = prov["extra_body"]
        profiles[pid] = profile
    return profiles


def sync_external_profiles(state):
    """每次加载时刷新内置 CLI 与 Miyu 镜像：元数据以外部为准，用户选过的 model / thinking 保留。"""
    profiles = state.setdefault("profiles", {})
    external = {}
    external.update(builtin_cli_profiles())
    external.update(miyu_profiles())
    for pid, fresh in external.items():
        old = profiles.get(pid)
        if isinstance(old, dict) and old.get("source") == fresh["source"]:
            if old.get("model"):
                fresh["model"] = old["model"]
            merged = dict(fresh.get("thinking") or {})
            merged.update({k: v for k, v in (old.get("thinking") or {}).items() if v})
            fresh["thinking"] = merged
        elif isinstance(old, dict):
            continue  # 用户自己的同名节点优先，不覆盖
        profiles[pid] = fresh
    for pid in list(profiles):
        prof = profiles[pid]
        if isinstance(prof, dict) and prof.get("source") in ("builtin", "miyu") and pid not in external:
            del profiles[pid]
    if state.get("active_profile") not in profiles:
        state["active_profile"] = next((k for k, v in profiles.items() if isinstance(v, dict) and profile_is_usable(v)), "")
    return state


def compose_system_prompt(settings, vocab):
    """系统提示词 + 自定义词库（与 Lua 侧 HTTP 路径拼法一致）。"""
    return str(settings.get("prompt", "")) + vocab_block(vocab)


def vocab_block(vocab):
    terms = [str(x) for x in (vocab or {}).get("terms", []) if str(x).strip()]
    mappings = {str(k): str(v) for k, v in ((vocab or {}).get("mappings") or {}).items() if str(k).strip()}
    if not terms and not mappings:
        return ""
    lines = ["", "# 用户词库"]
    if terms:
        lines.append("以下是用户常用的英文词/网络黑话，拼音中出现时按原样保留，不要当拼音切分：")
        lines.append("、".join(terms))
    if mappings:
        lines.append("以下是用户约定的简拼/缩写映射，遇到时优先按映射输出：")
        lines.extend(f"{k}={v}" for k, v in mappings.items())
    return "\n".join(lines)


def _run_cli(argv, stdin_text=None, cwd=None, timeout=DEFAULT_CLI_TIMEOUT, env=None):
    """跑一个 CLI 子进程，整组进程超时即杀；返回 (returncode, stdout, stderr_tail)。"""
    proc = subprocess.Popen(
        argv, cwd=cwd, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, encoding="utf-8", errors="replace", start_new_session=True,
    )
    try:
        out, err = proc.communicate(stdin_text or "", timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, 9)
        except OSError:
            pass
        proc.wait()
        raise RuntimeError(f"timed out after {timeout:g}s")
    return proc.returncode, out, err.strip()[-400:]


def _clean_answer(text):
    text = re.sub(r"<think>.*?</think>", "", text, flags=re.S)
    text = re.sub(r"<think>.*", "", text, flags=re.S)
    return text.strip()


def cli_complete(profile, system_prompt, user_text, timeout=DEFAULT_CLI_TIMEOUT):
    """本机 CLI 后端一次性问答，返回正文；失败抛 RuntimeError。"""
    protocol = stored_protocol(profile)
    model = str(profile.get("model", "")).strip() or CLI_BACKENDS.get(protocol, {}).get("default", "")
    binary = profile_binary(profile)
    variants, _ = reasoning_variants(profile, model)
    effort = profile_thinking(profile, model)
    if effort not in variants or effort == "off":
        effort = ""
    if not shutil.which(binary):
        raise RuntimeError(f"command not found: {binary}")
    with tempfile.TemporaryDirectory(prefix="rime-llm-") as workdir:
        if protocol == "claude-code":
            argv = [binary, "-p", "--output-format", "text", "--no-session-persistence", "--strict-mcp-config",
                    "--tools", "", "--model", model, "--system-prompt", system_prompt]
            if effort:
                argv += ["--effort", effort]
            rc, out, err = _run_cli(argv, user_text, cwd=workdir, timeout=timeout)
            text = _clean_answer(out)
            if rc != 0 or not text:
                raise RuntimeError(err or f"claude exited with {rc}")
            return text

        if protocol == "codex":
            sys_file = os.path.join(workdir, "instructions.md")
            with open(sys_file, "w", encoding="utf-8") as f:
                f.write(system_prompt)
            out_file = os.path.join(workdir, "answer.txt")
            argv = [binary, "exec", "--ephemeral", "--ignore-user-config", "--skip-git-repo-check",
                    "--color", "never", "-s", "read-only", "-C", workdir, "-m", model,
                    "-c", f'model_instructions_file="{sys_file}"', "-c", "project_doc_max_bytes=0",
                    "-o", out_file, "-"]
            if effort:
                argv += ["-c", f'model_reasoning_effort="{effort}"']
            rc, _, err = _run_cli(argv, user_text, cwd=workdir, timeout=timeout)
            text = ""
            try:
                with open(out_file, "r", encoding="utf-8") as f:
                    text = _clean_answer(f.read())
            except OSError:
                pass
            if not text:
                raise RuntimeError(err or f"codex exited with {rc}")
            return text

        combined = f"{system_prompt}\n\n---\n\n{user_text}"
        if protocol == "antigravity":
            # agy 的 --print 不读 stdin 文本，只能走 stream-json：一行 user 消息进，事件流出，取 result 帧
            argv = [binary, "--print=", "--input-format", "stream-json", "--output-format", "stream-json",
                    "--model", model, "--sandbox", "--add-dir", workdir, "--print-timeout", f"{int(timeout)}s"]
            if effort:
                argv += ["--effort", effort]
            payload = json.dumps({"event": "user", "message": {"content": [{"type": "text", "text": combined}]}},
                                 ensure_ascii=False) + "\n"
            rc, out, err = _run_cli(argv, payload, cwd=workdir, timeout=timeout)
            final, deltas = {}, []
            for line in out.splitlines():
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if event.get("event") == "result":
                    final.update(event.get("result") or {})
                elif event.get("event") == "step_update":
                    step = event.get("step_update") or {}
                    delta = (step.get("agent_response") or {}).get("text_delta") or step.get("text_delta")
                    if delta and step.get("step_type") in (None, "agent_response"):
                        deltas.append(delta)
            text = _clean_answer(str(final.get("response") or "".join(deltas)))
            if final.get("status") not in (None, "SUCCESS") or not text:
                raise RuntimeError(str(final.get("error") or err or f"agy exited with {rc}"))
            return text

        if protocol == "opencode":
            env = dict(os.environ, OPENCODE_DISABLE_PROJECT_CONFIG="1", OPENCODE_DISABLE_CLAUDE_CODE="1",
                       OPENCODE_DISABLE_LSP_DOWNLOAD="1")
            argv = [binary, "run", "--pure", "-m", model, "--dir", workdir]
            rc, out, err = _run_cli(argv, combined, cwd=workdir, timeout=timeout, env=env)
            text = _clean_answer(out)
            if rc != 0 or not text:
                raise RuntimeError(err or f"opencode exited with {rc}")
            return text

        if protocol == "miyu":
            rc, out, err = _run_cli([binary, "--stdout", "ask"], combined, cwd=workdir, timeout=timeout)
            text = _clean_answer(out)
            if rc != 0 or not text:
                raise RuntimeError(err or f"miyu exited with {rc}")
            return text

    raise RuntimeError(f"unsupported protocol: {protocol}")


def _settings_float(settings, key, default):
    try:
        return float(settings.get(key, default))
    except (TypeError, ValueError):
        return default


def _miyu_supports_json(path):
    """这个 miyu 认不认程序驱动那套参数（--output-format / --session）。
    旧版把不认识的参数当消息正文发出去，不会报错，所以必须先探测再调用。"""
    try:
        st = os.stat(path)
    except OSError:
        return False
    key, sig = os.path.realpath(path), f"{int(st.st_mtime)}:{st.st_size}"
    try:
        with open(MIYU_CAPS_FILE, "r", encoding="utf-8") as f:
            caps = json.load(f)
        if not isinstance(caps, dict):
            caps = {}
    except Exception:
        caps = {}
    hit = caps.get(key)
    if isinstance(hit, dict) and hit.get("sig") == sig:
        return bool(hit.get("ok"))
    try:
        _rc, out, _err = _run_cli([path, "ask", "--help"], "", timeout=15)
        ok = "--output-format" in out and "--session" in out
    except Exception:
        ok = False
    caps[key] = {"sig": sig, "ok": ok}
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(MIYU_CAPS_FILE, "w", encoding="utf-8") as f:
            json.dump(caps, f)
    except OSError:
        pass
    return ok


def find_miyu(settings):
    """挑一个够新的 miyu：设置里指定的优先，然后是 PATH，最后是常见安装位置。
    fcitx5 拉起的进程 PATH 常常没有 ~/.local/bin，所以不能只信 which。"""
    configured = str(settings.get("miyu_binary", "") or "").strip()
    if configured:
        path = shutil.which(configured) or (configured if os.path.isfile(configured) else "")
        if not path:
            raise RuntimeError(f"command not found: {configured}")
        if not _miyu_supports_json(path):
            raise RuntimeError(f"{path} is too old: `ask` lacks --output-format/--session")
        return path
    seen, outdated = [], ""
    for cand in (shutil.which("miyu"), os.path.expanduser("~/.local/bin/miyu"),
                 "/usr/local/bin/miyu", "/usr/bin/miyu"):
        if not cand or cand in seen or not os.path.isfile(cand):
            continue
        seen.append(cand)
        if _miyu_supports_json(cand):
            return cand
        outdated = outdated or cand
    if outdated:
        raise RuntimeError(f"{outdated} is too old: `ask` lacks --output-format/--session (update Miyu)")
    raise RuntimeError("command not found: miyu")


def miyu_chat(settings, vocab, text):
    """`miyu ask --session <名> --create --output-format json ...`：一行 done/error 事件，返回 (正文, 模型, 耗时ms)。"""
    binary = find_miyu(settings)
    session = str(settings.get("miyu_session", "") or "").strip() or DEFAULT_MIYU_SESSION
    timeout = _settings_float(settings, "miyu_timeout", DEFAULT_MIYU_TIMEOUT)
    host_prompt = str(settings.get("miyu_prompt", "") or "").strip() or DEFAULT_MIYU_PROMPT
    block = vocab_block(vocab)
    if block:
        host_prompt = f"{host_prompt}\n\n{block}"
    argv = [binary, "ask", "--session", session, "--create", "--output-format", "json", "--quiet",
            "--timeout", str(max(1, int(timeout))), "--append-system-prompt", host_prompt, "--stdin"]
    if not settings.get("miyu_tools", False):
        argv.append("--no-tools")
    with tempfile.TemporaryDirectory(prefix="rime-llm-") as workdir:
        rc, out, err = _run_cli(argv, text, cwd=workdir, timeout=timeout + 5)
    event = {}
    for line in reversed(out.splitlines()):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            candidate = json.loads(line)
        except ValueError:
            continue
        if isinstance(candidate, dict) and "type" in candidate:
            event = candidate
            break
    if event.get("type") == "done":
        answer = _clean_answer(str(event.get("text") or ""))
        if not answer:
            raise RuntimeError("miyu returned an empty answer")
        return answer, str(event.get("model") or ""), event.get("elapsed_ms")
    if event.get("type") == "error":
        kind = str(event.get("kind") or "error")
        msg = str(event.get("message") or "").strip()
        if kind == "timeout":
            raise RuntimeError(f"timed out after {timeout:g}s")
        raise RuntimeError(f"{kind}: {msg}" if msg else kind)
    if rc == 124:
        raise RuntimeError(f"timed out after {timeout:g}s")
    raise RuntimeError(err or _clean_answer(out)[-200:] or f"miyu exited with {rc}")


def run_chat(argv):
    """`rime-llm-config chat <text>`：把一句话发进 Miyu 的固定会话，正文写 stdout；
    失败时 stdout 首行为 `ERR: ...` 并以 1 退出（与 ask 同一套约定）。"""
    user_text = " ".join(argv).strip()
    if not user_text and not sys.stdin.isatty():
        user_text = sys.stdin.read().strip()
    if not user_text:
        print("ERR: empty input"); return 1
    state = load_state()
    settings = state.get("settings", {})
    session = settings.get("miyu_session", DEFAULT_MIYU_SESSION)
    t0 = time.time()
    try:
        answer, model, _elapsed = miyu_chat(settings, state.get("vocab", {}), user_text)
    except Exception as e:
        _debug_log(f"【Miyu 聊天】 {session}", user_text, f"ERR: {e}", time.time() - t0)
        print(f"ERR: {e}"); return 1
    _debug_log(f"【Miyu 聊天】 {session} ({model})", user_text, answer, time.time() - t0)
    sys.stdout.write(answer)
    return 0


def run_ask(argv):
    """`rime-llm-config ask [--profile ID] [--history TEXT] <text>`：一次性问答，正文写 stdout；
    失败时 stdout 首行为 `ERR: ...` 并以 1 退出（Lua 侧靠前缀分辨）。"""
    profile_id, history, text = "", "", []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--profile" and i + 1 < len(argv):
            profile_id = argv[i + 1]; i += 2
        elif a == "--history" and i + 1 < len(argv):
            history = argv[i + 1]; i += 2
        else:
            text.append(a); i += 1
    user_text = " ".join(text).strip()
    if not user_text and not sys.stdin.isatty():
        user_text = sys.stdin.read().strip()
    if not user_text:
        print("ERR: empty input"); return 1
    state = load_state()
    profile_id = profile_id or state.get("active_profile", "")
    profile = state.get("profiles", {}).get(profile_id)
    if not isinstance(profile, dict):
        print(f"ERR: profile not found: {profile_id}"); return 1
    if not profile_is_cli(profile):
        print(f"ERR: profile '{profile_id}' is not a CLI backend"); return 1
    settings = state.get("settings", {})
    system_prompt = compose_system_prompt(settings, state.get("vocab", {}))
    if history:
        user_text = f"【历史输入】：{history}\n【当前用户输入（如果由call开头说明是指令）】：{user_text}"
    try:
        timeout = float(settings.get("cli_timeout", DEFAULT_CLI_TIMEOUT))
    except (TypeError, ValueError):
        timeout = DEFAULT_CLI_TIMEOUT
    t0 = time.time()
    label = f"【CLI 节点】 {profile.get('name', '?')} ({stored_protocol(profile)} / {profile.get('model', '')})"
    try:
        answer = cli_complete(profile, system_prompt, user_text, timeout=timeout)
    except Exception as e:
        _debug_log(label, user_text, f"ERR: {e}", time.time() - t0)
        print(f"ERR: {e}"); return 1
    _debug_log(label, user_text, answer, time.time() - t0)
    sys.stdout.write(answer)
    return 0


def _debug_log(label, user_text, answer, elapsed):
    """与 Lua 侧共用 DEBUG_FLAG 触发器与 DEBUG_LOG 日志（路径由 config.lua 传给 Lua）。"""
    if not os.path.exists(DEBUG_FLAG):
        return
    try:
        os.makedirs(os.path.dirname(DEBUG_LOG), exist_ok=True)
        with open(DEBUG_LOG, "a", encoding="utf-8") as f:
            f.write("========== " + datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S") + " ==========\n")
            f.write(f"{label} {elapsed:.2f}s\n")
            f.write("【发出的文本】\n" + user_text + "\n\n【收到的返回】\n" + answer + "\n")
            f.write("==================================================\n\n")
    except OSError:
        pass


