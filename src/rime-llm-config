# 🚀 主运行程序
# ==========================================

def run_app(stdscr):
    init_colors()
    curses.curs_set(0)
    state = load_state()

    while True:
        act_name = state["profiles"].get(state.get("active_profile", ""), {}).get("name", "None")
        main_opts =[
            (t('tui_opt_switch', act_name), "switch"),
            (t('tui_opt_edit'), "edit_profiles"),
            (t('tui_opt_settings'), "edit_settings"),
            (t('tui_opt_vocab'), "edit_vocab"),
            (t('tui_opt_prefix'), "edit_prefix"),
            (t('tui_opt_saver'), "edit_saver"),
            (t('tui_opt_miyu', str(state["settings"].get("miyu_prefix", "") or "").strip() or t('tui_miyu_off')), "edit_miyu"),
            (t('tui_opt_export'), "export")
        ]

        choice = menu_dialog(stdscr, t('tui_main_title'), main_opts)
        if choice in (None, "QUIT", "exit"): break

        if choice == "switch":
            valid_opts =[]
            for k, v in state["profiles"].items():
                if profile_is_usable(v):
                    tag = profile_tag(v)
                    think = profile_thinking(v)
                    extra = f" ({variant_label(think)})" if think and think != "off" else ""
                    valid_opts.append((f"{('[' + tag + '] ') if tag else ''}{v.get('name', k)} [{v.get('model')}]{extra}", k))
            if not valid_opts:
                msgbox(stdscr, t('msg_info'), t('tui_sw_err'))
                continue

            res = menu_dialog(stdscr, t('tui_sw_title'), valid_opts, allow_search=True)
            if res and res != 'QUIT': state["active_profile"] = res; save_state(state)

        elif choice == "edit_profiles":
            ProviderEditorTUI(stdscr, state).run()

        elif choice == "edit_settings":
            s = state["settings"]

            fields_config = [
                {"label": t('tui_st_prompt'), "value": s.get("prompt", ""), "type": "textarea"},
                {"label": t('tui_st_trigger'), "value": s.get("ai_trigger", "vv")},
                {"label": t('tui_st_tokens'), "value": str(s.get("max_tokens", 4000))},
                {"label": t('tui_st_temp'), "value": str(s.get("temperature", 0.1))},
                {"label": t('tui_st_time'), "value": str(s.get("max_time", 30.0))},
                {"label": t('tui_st_history_bytes'), "value": str(s.get("max_history_bytes", 240))},
                {"label": t('tui_st_cli_timeout'), "value": str(s.get("cli_timeout", DEFAULT_CLI_TIMEOUT))},
            ]

            res = form_dialog(stdscr, t('tui_st_title'), fields_config)
            if res:
                s["prompt"], s["ai_trigger"] = res[0], (res[1].strip() or "vv")
                s["max_tokens"] = int(res[2]) if res[2].isdigit() else 4000
                s["temperature"] = float(res[3]) if res[3].replace('.','',1).isdigit() else 0.1
                s["max_time"] = float(res[4]) if res[4].replace('.','',1).isdigit() else 30.0
                s["max_history_bytes"] = int(res[5]) if res[5].isdigit() else 240
                s["cli_timeout"] = float(res[6]) if res[6].replace('.','',1).isdigit() else DEFAULT_CLI_TIMEOUT
                save_state(state)

        elif choice == "edit_miyu":
            s = state["settings"]
            try:
                find_miyu(s)
            except Exception as e:
                msgbox(stdscr, t('msg_info'), t('tui_miyu_bad', e))
            fields_miyu = [
                {"label": t('tui_st_miyu_prefix'), "value": str(s.get("miyu_prefix", DEFAULT_MIYU_PREFIX) or "")},
                {"label": t('tui_st_miyu_session'), "value": str(s.get("miyu_session", DEFAULT_MIYU_SESSION) or "")},
                {"label": t('tui_st_miyu_timeout'), "value": str(s.get("miyu_timeout", DEFAULT_MIYU_TIMEOUT))},
                {"label": t('tui_st_miyu_wait'), "value": str(s.get("miyu_wait", DEFAULT_MIYU_WAIT))},
                {"label": t('tui_st_miyu_tools'), "value": t('tui_yes') if s.get("miyu_tools") else t('tui_no'),
                 "type": "select", "options": [t('tui_no'), t('tui_yes')]},
                {"label": t('tui_st_miyu_binary'), "value": str(s.get("miyu_binary", "") or "")},
                {"label": t('tui_st_miyu_prompt'), "value": s.get("miyu_prompt", DEFAULT_MIYU_PROMPT), "type": "textarea"},
            ]
            res = form_dialog(stdscr, t('tui_miyu_title'), fields_miyu)
            if res:
                s["miyu_prefix"] = res[0].strip()
                s["miyu_session"] = res[1].strip() or DEFAULT_MIYU_SESSION
                s["miyu_timeout"] = float(res[2]) if res[2].replace('.','',1).isdigit() else DEFAULT_MIYU_TIMEOUT
                s["miyu_wait"] = float(res[3]) if res[3].replace('.','',1).isdigit() else DEFAULT_MIYU_WAIT
                s["miyu_tools"] = (res[4] == t('tui_yes'))
                s["miyu_binary"] = res[5].strip()
                s["miyu_prompt"] = res[6].strip() or DEFAULT_MIYU_PROMPT
                save_state(state)

        elif choice == "edit_prefix":
            last_deleted_rule = None
            while True:
                pf = state.setdefault("prefixes", default_prefixes())
                pos_labels = {"system": t('tui_px_pos_system'), "user_before": t('tui_px_pos_before'),
                              "user_after": t('tui_px_pos_after')}
                p_choice = menu_dialog(stdscr, t('tui_px_title'), [
                    (t('tui_px_opt_rules'), "rules"),
                    (t('tui_px_opt_combo'), "combo"),
                    (t('tui_px_opt_fallback'), "fallback"),
                    (f"{t('tui_px_opt_pos')}  [{pos_labels[prefix_position(state['settings'])]}]", "pos"),
                ])
                if p_choice in (None, 'QUIT'):
                    break

                if p_choice == "rules":
                    while True:
                        rules = pf.setdefault("rules", [])
                        opts = [(f"{r.get('key','')}: {str(r.get('rule','')).splitlines()[0][:46]}", r.get("key", ""))
                                for r in rules if isinstance(r, dict)]
                        sel_action, sel_val = menu_dialog(
                            stdscr, t('tui_px_rules_title'), opts + [(t('tui_px_add'), "NEW")],
                            hint=t('tui_hint_menu_del'), allow_delete=True, allow_undo=True, allow_search=True) or (None, None)
                        if sel_action in (None, 'QUIT'):
                            break
                        idx = next((i for i, r in enumerate(rules) if r.get("key") == sel_val), None)
                        if sel_action == 'DELETE' and idx is not None:
                            last_deleted_rule = (idx, rules.pop(idx)); save_state(state)
                        elif sel_action == 'UNDO' and last_deleted_rule:
                            rules.insert(min(last_deleted_rule[0], len(rules)), last_deleted_rule[1])
                            save_state(state); last_deleted_rule = None
                        elif sel_action == 'SELECT':
                            is_new = sel_val == "NEW"
                            cur = {"key": "", "rule": ""} if is_new else rules[idx]
                            res = form_dialog(
                                stdscr, t('tui_px_fm_add') if is_new else t('tui_px_fm_edit'),
                                [{"label": t('tui_lbl_prefix'), "value": cur.get("key", ""),
                                  "hint": t('tui_px_key_hint')},
                                 {"label": t('tui_lbl_rule'), "value": cur.get("rule", ""), "type": "textarea"}],
                                show_delete=not is_new)
                            if res == "DELETE" and idx is not None:
                                last_deleted_rule = (idx, rules.pop(idx)); save_state(state)
                            elif isinstance(res, list):
                                key = res[0].strip().lower().strip(":：")
                                if not re.fullmatch(r"[a-z]+", key or ""):
                                    msgbox(stdscr, t('msg_info'), t('tui_px_bad_key'))
                                elif res[1].strip():
                                    entry = {"key": key, "rule": res[1].strip()}
                                    # 先把这一条和任何同名的摘掉，再插回原来的位置——改名撞上
                                    # 已有前缀时不会留下两条同名的
                                    kept = [r for i, r in enumerate(rules)
                                            if r.get("key") != key and (is_new or i != idx)]
                                    at = len(kept) if is_new or idx is None else min(idx, len(kept))
                                    kept.insert(at, entry)
                                    rules[:] = kept
                                    save_state(state)

                elif p_choice in ("combo", "fallback"):
                    is_combo = p_choice == "combo"
                    field = {"label": t('tui_lbl_rule'), "type": "textarea",
                             "value": str(pf.get(p_choice, "") or "")}
                    if not is_combo:
                        field["hint"] = t('tui_px_fallback_hint')
                    res = form_dialog(stdscr, t('tui_px_combo_title') if is_combo else t('tui_px_fallback_title'),
                                      [field])
                    if isinstance(res, list):
                        pf[p_choice] = res[0].strip(); save_state(state)

                elif p_choice == "pos":
                    cur = prefix_position(state["settings"])
                    order = ["user_before", "user_after", "system"]
                    sel = menu_dialog(stdscr, t('tui_px_pos_title'), [(pos_labels[k], k) for k in order],
                                      default_idx=order.index(cur) if cur in order else 0)
                    if sel and sel != 'QUIT':
                        state["settings"]["prefix_position"] = sel; save_state(state)

        elif choice == "edit_saver":
            s = state["settings"]
            auto_l, all_l = t('tui_inject_auto'), t('tui_inject_all')
            yes_l, no_l = t('tui_yes'), t('tui_no')

            def _pick(flag, on=None, off=None):
                return (on or yes_l) if flag else (off or no_l)

            fields_saver = [
                {"label": t('tui_sv_prefix'), "type": "select", "options": [auto_l, all_l],
                 "value": _pick(str(s.get("prefix_inject", "auto")) == "auto", auto_l, all_l)},
                {"label": t('tui_sv_vocab'), "type": "select", "options": [auto_l, all_l],
                 "value": _pick(str(s.get("vocab_inject", "auto")) == "auto", auto_l, all_l)},
                {"label": t('tui_sv_nohist'), "value": str(s.get("no_history_prefixes", DEFAULT_NO_HISTORY_PREFIXES) or "")},
                {"label": t('tui_sv_adaptive'), "type": "select", "options": [yes_l, no_l],
                 "value": _pick(s.get("adaptive_max_tokens", True))},
                {"label": t('tui_sv_mark'), "type": "select", "options": [yes_l, no_l],
                 "value": _pick(s.get("prompt_cache_mark", True))},
                {"label": t('tui_sv_disk'), "type": "select", "options": [yes_l, no_l],
                 "value": _pick(s.get("reply_cache_disk", True))},
                {"label": t('tui_sv_disk_min'), "value": str(s.get("reply_cache_min_len", DEFAULT_REPLY_CACHE_MIN_LEN))},
                {"label": t('tui_sv_disk_max'), "value": str(s.get("reply_cache_max", DEFAULT_REPLY_CACHE_MAX))},
                {"label": t('tui_sv_reset'), "type": "select", "options": [no_l, yes_l], "value": no_l},
            ]
            res = form_dialog(stdscr, t('tui_sv_title'), fields_saver)
            if res:
                s["prefix_inject"] = "auto" if res[0] == auto_l else "always"
                s["vocab_inject"] = "auto" if res[1] == auto_l else "always"
                s["no_history_prefixes"] = res[2].strip()
                s["adaptive_max_tokens"] = (res[3] == yes_l)
                s["prompt_cache_mark"] = (res[4] == yes_l)
                s["reply_cache_disk"] = (res[5] == yes_l)
                s["reply_cache_min_len"] = int(res[6]) if res[6].isdigit() else DEFAULT_REPLY_CACHE_MIN_LEN
                s["reply_cache_max"] = int(res[7]) if res[7].isdigit() else DEFAULT_REPLY_CACHE_MAX
                reset_prompt = res[8] == yes_l
                if reset_prompt:
                    default_prompt = get_default_state().get("settings", {}).get("prompt", "")
                    if default_prompt:
                        s["prompt"] = default_prompt
                save_state(state)
                if reset_prompt:
                    msgbox(stdscr, t('msg_info'), t('tui_sv_reset_done'))

        elif choice == "edit_vocab":
            last_deleted_term, last_deleted_map = None, None
            while True:
                v_choice = menu_dialog(stdscr, t('tui_vc_title'),[(t('tui_vc_opt_term'), "terms"), (t('tui_vc_opt_map'), "mapping")])
                if v_choice in (None, 'QUIT'): break
                if v_choice == "terms":
                    while True:
                        terms = state["vocab"].setdefault("terms",[])
                        sel_action, sel_val = menu_dialog(stdscr, t('tui_vc_term_title'), [(x, x) for x in terms] +[(t('tui_vc_add_term'), "NEW")], hint=t('tui_hint_menu_del'), allow_delete=True, allow_undo=True, allow_search=True) or (None, None)
                        if sel_action in (None, 'QUIT'): break
                        if sel_action == 'DELETE':
                            last_deleted_term = sel_val; terms.remove(sel_val); save_state(state)
                        elif sel_action == 'UNDO' and last_deleted_term:
                            terms.append(last_deleted_term); save_state(state); last_deleted_term = None
                        elif sel_action == 'SELECT':
                            if sel_val == "NEW":
                                res = form_dialog(stdscr, t('tui_vc_fm_add_term'), [{"label": t('tui_lbl_term'), "value": ""}])
                                if res and res[0]: terms.append(res[0]); save_state(state)
                            else:
                                res = form_dialog(stdscr, t('tui_vc_fm_edit_term'),[{"label": t('tui_lbl_term'), "value": sel_val}], show_delete=True)
                                if res == "DELETE":
                                    terms.remove(sel_val); save_state(state)
                                elif isinstance(res, list) and res[0].strip():
                                    terms.remove(sel_val); terms.append(res[0].strip()); save_state(state)
                elif v_choice == "mapping":
                    while True:
                        maps = state["vocab"].setdefault("mappings", {})
                        sel_action, sel_val = menu_dialog(stdscr, t('tui_vc_map_title'),[(f"{k} = {v}", k) for k, v in maps.items()] +[(t('tui_vc_add_map'), "NEW")], hint=t('tui_hint_menu_del'), allow_delete=True, allow_undo=True, allow_search=True) or (None, None)
                        if sel_action in (None, 'QUIT'): break
                        if sel_action == 'DELETE':
                            last_deleted_map = (sel_val, maps[sel_val]); del maps[sel_val]; save_state(state)
                        elif sel_action == 'UNDO' and last_deleted_map:
                            maps[last_deleted_map[0]] = last_deleted_map[1]; save_state(state); last_deleted_map = None
                        elif sel_action == 'SELECT':
                            if sel_val == "NEW":
                                res = form_dialog(stdscr, t('tui_vc_fm_add_map'),[{"label": t('tui_lbl_pinyin'), "value": ""}, {"label": t('tui_lbl_result'), "value": ""}])
                                if res and res[0] and res[1]: maps[res[0]] = res[1]; save_state(state)
                            else:
                                res = form_dialog(stdscr, t('tui_vc_fm_edit_map'),[{"label": t('tui_lbl_pinyin'), "value": sel_val}, {"label": t('tui_lbl_result'), "value": maps[sel_val]}], show_delete=True)
                                if res == "DELETE":
                                    del maps[sel_val]; save_state(state)
                                elif isinstance(res, list) and res[0].strip():
                                    del maps[sel_val]; maps[res[0].strip()] = res[1]; save_state(state)

        elif choice == "export":
            try:
                save_state(state, export=False)
                out = export_to_lua(state)
                msgbox(stdscr, t('tui_exp_succ'), t('tui_exp_msg', out))
                break
            except Exception as e:
                msgbox(stdscr, t('tui_exp_err'), str(e))

if __name__ == "__main__":
    if cli_handler(): sys.exit(0)
    try: curses.wrapper(run_app)
    except KeyboardInterrupt: pass
    except Exception as e: print(f"Fatal error: {e}")
