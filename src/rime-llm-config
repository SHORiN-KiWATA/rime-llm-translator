def init_rime_config():
    print(f"{L_INFO} " + t("cli_init_start"))
    rime_dir = os.path.expanduser("~/.local/share/fcitx5/rime")
    if not os.path.exists(rime_dir):
        print(f"{L_WARN} " + t("cli_init_mkdir", rime_dir))
        os.makedirs(rime_dir, exist_ok=True)

    print(f"{L_INFO} " + t("cli_init_gen_config"))
    state = load_state()
    save_state(state)
    print(f"{L_OK} " + t("cli_init_ok_config", CONFIG_DIR))

    rime_lua = os.path.join(rime_dir, "rime.lua")
    lua_inject = RIME_LUA_TRANSLATOR + "\n" + RIME_LUA_PROCESSOR + "\n"
    if os.path.exists(rime_lua):
        with open(rime_lua, 'r', encoding='utf-8') as f: content = f.read()
        if "llm_translator" not in content:
            backup_file(rime_lua)
            with open(rime_lua, 'a', encoding='utf-8') as f: f.write("\n" + lua_inject)
            print(f"{L_OK} " + t("cli_init_ok_lua"))
        elif "llm_processor" not in content:
            backup_file(rime_lua)
            with open(rime_lua, 'a', encoding='utf-8') as f: f.write("\n" + RIME_LUA_PROCESSOR + "\n")
            print(f"{L_OK} " + t("cli_init_upg_lua"))
        else: print(f"{L_SKIP} " + t("cli_init_skip_lua"))
    else:
        with open(rime_lua, 'w', encoding='utf-8') as f: f.write(lua_inject)
        print(f"{L_OK} " + t("cli_init_new_lua"))

    ice_installed = os.path.exists("/usr/share/rime-data/rime_ice.schema.yaml") or \
                    os.path.exists(os.path.join(rime_dir, "rime_ice.schema.yaml"))

    if ice_installed:
        print(f"{L_INFO} " + t("cli_init_ice_det"))
        custom_yaml = os.path.join(rime_dir, "rime_ice.custom.yaml")
        if os.path.exists(custom_yaml):
            with open(custom_yaml, 'r', encoding='utf-8') as f: content = f.read()
            if "llm_translator" not in content:
                backup_file(custom_yaml)
                if "patch:" in content:
                    content = content.replace("patch:", "patch:\n" + PATCH_CONTENT, 1)
                    with open(custom_yaml, 'w', encoding='utf-8') as f: f.write(content)
                else:
                    with open(custom_yaml, 'a', encoding='utf-8') as f: f.write("\npatch:\n" + PATCH_CONTENT)
                print(f"{L_OK} " + t("cli_init_ok_yaml"))
            elif "llm_processor" not in content:
                backup_file(custom_yaml)
                new_content = content.replace(OLD_ALPHABET_LINE, NEW_ALPHABET_LINE)
                if TRANSLATOR_LINE in new_content:
                    idx = new_content.index(TRANSLATOR_LINE)
                    line_start = new_content.rfind("\n", 0, idx) + 1
                    indent = new_content[line_start:idx]
                    new_content = new_content[:line_start] + indent + PROCESSOR_LINE + "\n" + new_content[line_start:]
                with open(custom_yaml, 'w', encoding='utf-8') as f: f.write(new_content)
                print(f"{L_OK} " + t("cli_init_upg_yaml"))
            else: print(f"{L_SKIP} " + t("cli_init_skip_yaml"))
        else:
            with open(custom_yaml, 'w', encoding='utf-8') as f: f.write("patch:\n" + PATCH_CONTENT)
            print(f"{L_OK} " + t("cli_init_new_yaml"))
    else:
        print(f"{L_WARN} " + t("cli_init_no_ice"))

    restart_fcitx5()
    print_tutorial()

