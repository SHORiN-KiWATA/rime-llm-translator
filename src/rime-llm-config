_catalog_cache = {"data": None, "path": None}


def _catalog_candidates():
    return [p for p in (MIYU_CATALOG, CATALOG_FILE) if os.path.isfile(p)]


def catalog_path():
    """优先用较新的那份：Miyu 的缓存或自己拉的。"""
    paths = _catalog_candidates()
    if not paths:
        return None
    return max(paths, key=lambda p: os.path.getmtime(p))


def catalog_load():
    if _catalog_cache["data"] is not None:
        return _catalog_cache["data"]
    data = {}
    path = catalog_path()
    if path:
        try:
            with open(path, "r", encoding="utf-8") as f:
                raw = json.load(f)
            if isinstance(raw, dict):
                data = {k: v for k, v in raw.items() if isinstance(v, dict) and isinstance(v.get("models"), dict)}
        except (OSError, ValueError):
            data = {}
    _catalog_cache["data"] = data
    _catalog_cache["path"] = path
    return data


def catalog_needs_refresh():
    if os.path.isfile(MIYU_CATALOG):
        return False
    try:
        return time.time() - os.path.getmtime(CATALOG_FILE) > CATALOG_TTL
    except OSError:
        return True


def catalog_refresh(timeout=15):
    req = urllib.request.Request(CATALOG_URL, headers={"User-Agent": "rime-llm-translator", "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        text = resp.read().decode("utf-8")
    data = json.loads(text)
    if not isinstance(data, dict) or not data:
        raise ValueError("empty catalog")
    os.makedirs(CACHE_DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".models_dev-", suffix=".json", dir=CACHE_DIR)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, CATALOG_FILE)
    _catalog_cache["data"] = None
    return catalog_load()


def _norm_base_url(url):
    u = (url or "").strip().lower().rstrip("/")
    for suffix in ("/chat/completions", "/messages", "/openai", "/api/chat"):
        if u.endswith(suffix):
            u = u[: -len(suffix)]
    return u.rstrip("/")


def catalog_provider_for(profile, pid=""):
    """按 base_url 对齐 models.dev 的供应商键；对不上时退到 id / 域名关键字。"""
    cat = catalog_load()
    if not cat:
        return None
    base = _norm_base_url(profile.get("api_url", ""))
    if base:
        best = None
        for key, prov in cat.items():
            api = _norm_base_url(prov.get("api", ""))
            if api and (base == api or base.startswith(api + "/")):
                if best is None or len(api) > len(_norm_base_url(cat[best].get("api", ""))):
                    best = key
        if best:
            return best
    pid_l = (pid or "").lower()
    if pid_l in cat:
        return pid_l
    host = re.sub(r"^https?://", "", base).split("/")[0]
    for key in cat:
        if key and (key in host or key in pid_l):
            return key
    return None


_MODEL_PREFIX_PROVIDERS = [
    ("claude-", "anthropic"), ("deepseek-", "deepseek"), ("gemini-", "google"), ("gemma-", "google"),
    ("gpt-", "openai"), ("o1", "openai"), ("o3", "openai"), ("o4", "openai"), ("mimo-", "xiaomi"),
    ("glm-", "zhipuai"), ("qwen", "alibaba"), ("kimi-", "moonshotai"), ("minimax-", "minimax"), ("grok-", "xai"),
]


def _reasoning_signature(minfo):
    return json.dumps([bool(minfo.get("reasoning")), minfo.get("reasoning_options") or []], sort_keys=True)


def catalog_model_info(profile, model, pid=""):
    """返回 (models.dev 的模型条目 或 None, 对齐到的供应商键 或 None)。"""
    cat = catalog_load()
    if not cat or not model:
        return None, None
    provider_key = catalog_provider_for(profile, pid)
    if provider_key and model in cat[provider_key]["models"]:
        return cat[provider_key]["models"][model], provider_key
    bare = model.split("/", 1)[-1]
    ml = model.lower()
    for prefix, cpid in _MODEL_PREFIX_PROVIDERS:
        if (ml.startswith(prefix) or bare.lower().startswith(prefix)) and cpid in cat:
            models = cat[cpid]["models"]
            if model in models:
                return models[model], provider_key
            if bare in models:
                return models[bare], provider_key
    groups = {}
    for prov in cat.values():
        for candidate in (model, bare):
            minfo = prov["models"].get(candidate)
            if isinstance(minfo, dict):
                sig = _reasoning_signature(minfo)
                groups.setdefault(sig, [0, minfo])[0] += 1
                break
    if groups:
        ranked = sorted(groups.values(), key=lambda x: -x[0])
        if len(ranked) == 1 or ranked[0][0] > ranked[1][0]:
            return ranked[0][1], provider_key
    return None, provider_key


def vendor_family(profile, model, provider_key=None, pid=""):
    """厂商族：决定思考档怎么落到请求体上。"""
    if effective_protocol(profile) == "anthropic":
        return "anthropic"
    url = str(profile.get("api_url", "")).lower()
    ml = (model or "").lower()
    hay = " ".join([provider_key or "", url, ml, (pid or "").lower()])
    if "openrouter" in hay:
        return "openrouter"
    if "deepseek" in hay:
        return "deepseek"
    if "xiaomi" in hay or "mimo" in ml:
        return "mimo"
    if "dashscope" in url or provider_key == "alibaba":
        return "alibaba"
    if "bigmodel" in url or "zhipu" in hay or "z.ai" in url:
        return "zhipu"
    if "generativelanguage" in url or provider_key == "google" or ml.startswith("gemini"):
        return "gemini"
    return "generic"


def _catalog_variants(minfo):
    """models.dev 的 reasoning_options → 变体 id 列表（不含 off）。返回 None 表示模型不会思考。"""
    if not isinstance(minfo, dict):
        return None
    opts = [o for o in (minfo.get("reasoning_options") or []) if isinstance(o, dict)]
    if not minfo.get("reasoning") and not opts:
        return None
    effort = next((o for o in opts if o.get("type") == "effort"), None)
    if effort:
        return [str(v) for v in (effort.get("values") or []) if v]
    if any(o.get("type") in ("toggle", "budget_tokens") for o in opts):
        return ["on"]
    return []


def reasoning_variants(profile, model, pid=""):
    """可选思考档 id 列表（首项永远是 off），以及用到的厂商族。"""
    model = model or str(profile.get("model", ""))
    proto = stored_protocol(profile)
    if is_cli_protocol(proto):
        variants = list(CLI_VARIANTS.get(proto, []))
        if proto == "claude-code" and model == "haiku":
            variants = []
        if proto == "antigravity" and not model.startswith("claude-"):
            variants = []
        return ["off"] + variants, "cli"
    minfo, provider_key = catalog_model_info(profile, model, pid)
    family = vendor_family(profile, model, provider_key, pid)
    catalog_variants = _catalog_variants(minfo)
    if catalog_variants is None:
        variants = [] if minfo is not None else list(FAMILY_DEFAULT_VARIANTS.get(family, []))
    elif not catalog_variants and family in TOGGLE_FAMILIES:
        variants = ["on"]  # 目录说会思考但没给档位：有原生开关的厂商就给一个开关
    else:
        variants = catalog_variants
    if family == "generic" and minfo is None:
        variants = []
    seen, ordered = set(), []
    for vid in ["off"] + variants:
        if vid not in seen:
            seen.add(vid); ordered.append(vid)
    return ordered, family


def model_has_reasoning(profile, model, pid=""):
    variants, _ = reasoning_variants(profile, model, pid)
    return len(variants) > 1


def _variant_wire(family, model, vid, settings, minfo):
    """(附加字段 dict, 运行时模型名 或 None, 是否省略 temperature)"""
    extra, new_model, omit_temp = {}, None, False
    kind = "off" if vid in ("", "off") else ("on" if vid == "on" else "effort")
    if family == "anthropic":
        if kind != "off":
            omit_temp = True
            opts = [o for o in ((minfo or {}).get("reasoning_options") or []) if isinstance(o, dict)]
            has_effort = any(o.get("type") == "effort" for o in opts)
            if kind == "effort":
                extra = {"thinking": {"type": "adaptive"}, "output_config": {"effort": vid}}
            elif has_effort or any(o.get("type") == "toggle" for o in opts):
                extra = {"thinking": {"type": "adaptive"}}
            else:
                try:
                    max_tokens = int(settings.get("max_tokens", 4000))
                except (TypeError, ValueError):
                    max_tokens = 4000
                budget = max(1024, int(max_tokens * 0.8))
                extra = {"thinking": {"type": "enabled", "budget_tokens": budget}}
                if max_tokens <= budget:
                    extra["max_tokens"] = budget + 256
    elif family == "deepseek":
        if kind == "off":
            extra = {"thinking": {"type": "disabled"}}
            if model == "deepseek-reasoner":
                new_model = "deepseek-chat"
        else:
            extra = {"thinking": {"type": "enabled"}}
            if kind == "effort":
                extra["reasoning_effort"] = vid
            if model == "deepseek-chat":
                new_model = "deepseek-reasoner"
    elif family in ("mimo", "zhipu"):
        extra = {"thinking": {"type": "disabled" if kind == "off" else "enabled"}}
        if kind == "effort":
            extra["reasoning_effort"] = vid
    elif family == "gemini":
        if kind == "off":
            extra = {"reasoning_effort": "low"}
        elif kind == "effort":
            extra = {"reasoning_effort": vid}
    elif family == "openrouter":
        if kind == "on":
            extra = {"reasoning": {"enabled": True}}
        elif kind == "effort":
            extra = {"reasoning": {"effort": vid}}
    elif family == "alibaba":
        extra = {"enable_thinking": kind != "off"}
        if kind == "effort":
            extra["reasoning_effort"] = vid
    else:
        if kind == "on":
            extra = {"thinking": {"type": "enabled"}}
        elif kind == "effort":
            extra = {"reasoning_effort": vid}
    return extra, new_model, omit_temp


def resolve_request(profile, settings, pid=""):
    """把节点 + 模型 + 思考档解析成 Lua 只需拼接的结果。"""
    model = str(profile.get("model", "")).strip()
    proto = stored_protocol(profile)
    result = {"protocol": effective_protocol(profile), "model": model, "thinking": profile_thinking(profile, model),
              "request_extra": {}, "temperature": None}
    if is_cli_protocol(proto):
        return result
    variants, family = reasoning_variants(profile, model, pid)
    vid = result["thinking"] if result["thinking"] in variants else "off"
    result["thinking"] = vid if result["thinking"] else ""
    minfo, _ = catalog_model_info(profile, model, pid)
    extra = {}
    user_extra = profile.get("extra_body")
    if isinstance(user_extra, dict):
        extra.update(user_extra)
    wire, new_model, omit_temp = _variant_wire(family, model, vid, settings, minfo)
    extra.update(wire)
    result["request_extra"] = extra
    if new_model:
        result["model"] = new_model
    temps = profile.get("model_temperature")
    if isinstance(temps, dict) and model in temps:
        try:
            result["temperature"] = float(temps[model])
        except (TypeError, ValueError):
            pass
    if omit_temp:
        result["temperature"] = False
    return result


