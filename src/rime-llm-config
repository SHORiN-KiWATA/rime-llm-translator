            print(f"{t('cli_stat_model')} {p.get('model', 'None')}" + (f" → {resolved['model']}" if resolved.get('model') and resolved['model'] != p.get('model') else ""))
            print(f"{t('cli_stat_proto')} {resolved['protocol']}" + (f" ({profile_binary(p)})" if p and profile_is_cli(p) else ""))
            print(f"{t('cli_stat_think')} {variant_label(resolved['thinking'] or 'off')}")
            if resolved.get("request_extra"):
                print(f"{t('cli_stat_extra')} {json.dumps(resolved['request_extra'], ensure_ascii=False)}")
            print(f"{t('cli_stat_state')} {STATE_FILE}")
            print(f"{t('cli_stat_lua')} {LUA_FILE}")

            print(f"\n{C_CYN}{C_BLD}[ {t('tui_opt_settings')} ]{C_RES}")
            print(f"  {pad_str(t('tui_st_trigger'), 25)}: {s.get('ai_trigger', 'vv')}")
            print(f"  {pad_str(t('tui_st_tokens'), 25)}: {s.get('max_tokens', 4000)}")
            print(f"  {pad_str(t('tui_st_temp'), 25)}: {s.get('temperature', 0.1)}")
            print(f"  {pad_str(t('tui_st_time'), 25)}: {s.get('max_time', 30.0)}")
            print(f"  {pad_str(t('tui_st_history_bytes'), 25)}: {s.get('max_history_bytes', 240)}")
            prefix = str(s.get("miyu_prefix", DEFAULT_MIYU_PREFIX) or "").strip()
            if prefix:
                try:
                    where = find_miyu(s)
                except Exception as e:
                    where = f"! {e}"
                miyu_desc = (f"{prefix} → session '{s.get('miyu_session', DEFAULT_MIYU_SESSION)}', "
                             f"{s.get('miyu_timeout', DEFAULT_MIYU_TIMEOUT)}s, "
                             f"tools={'on' if s.get('miyu_tools') else 'off'}, {where}")
            else:
                miyu_desc = "off"
            print(f"  {pad_str(t('cli_stat_miyu'), 25)}: {miyu_desc}")

            prompt = s.get("prompt", "None")
            print(f"\n{C_CYN}{C_BLD}[ {t('tui_st_prompt')} ]{C_RES}")
            print(f"{C_GRY}{prompt}{C_RES}\n")
            return True
        elif cmd == "tui": return False
        else:
            print(f"{L_ERR} " + t("cli_err_cmd", cmd))
            print_help()
            return True
    return False

